NODE_ENV=development
PORT=3500
WEB_ORIGIN=http://localhost:5173

# 서울 열린데이터광장 OpenAPI 인증키
SEOUL_API_KEY=replace_me
SEOUL_OPENAPI_KEY=replace_me
SEOUL_API_BASE_URL=http://openapi.seoul.go.kr:8088
SEOUL_CITYDATA_SERVICE=citydata

# Google Gemini API 인증키
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true

# 데이터 저장 경로 설정
DB_PATH=./data/tteum.db
RAW_DATA_DIR=./data/raw

# VWorld API 인증키
VWORLD_API_KEY=replace_me

CACHE_CITYDATA_SECONDS=180
CACHE_EVENTS_SECONDS=21600
REQUEST_TIMEOUT_MS=8000
